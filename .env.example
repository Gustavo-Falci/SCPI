# ============================================================
# SCPI — Template de variáveis de ambiente
# Copie este arquivo para .env e preencha com valores reais.
#
# Organizado por SUBSISTEMA. Cada máquina só precisa do bloco
# que usa:
#   - API (VM de produção): 1 a 7
#   - Máquina da câmera:    1, 8 e 9
#   - Dev:                  tudo + bloco 12
# ============================================================


# ============================================================
# 1. AMBIENTE
# ============================================================

# "production" habilita HSTS e demais hardenings que exigem HTTPS.
# Em dev (HTTP local), deixe vazio para não forçar HTTPS no browser via HSTS.
ENVIRONMENT=

# Origens permitidas no CORS, separadas por vírgula. Obrigatório em produção.
# Em dev, pode deixar vazio — o backend usará localhost apenas.
ALLOWED_ORIGINS=


# ============================================================
# 2. BANCO DE DADOS (PostgreSQL)
# ============================================================

# Obrigatórias: a API falha no startup se qualquer uma faltar.
DB_HOST=
DB_PORT=
DB_NAME=
DB_USER=
DB_PASSWORD=

# Pool de conexões (psycopg2). Defaults: 1 e 10.
DB_POOL_MIN=
DB_POOL_MAX=

# Timeout (s) para abrir conexão. Banco fora → erro rápido em vez de pendurar 60s.
# O /health custa até 2x este valor quando o banco está inacessível. Default 3.
DB_CONNECT_TIMEOUT=


# ============================================================
# 3. AUTENTICAÇÃO E SESSÃO
# ============================================================

# Chave de assinatura do JWT (HS256). Mínimo 32 caracteres — a API recusa subir
# com chave menor. Gere com:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=

# Expiração do access token, em minutos (default 15).
ACCESS_TOKEN_EXPIRE_MINUTES=

# Expiração do refresh token, em dias (default 7).
REFRESH_TOKEN_EXPIRE_DAYS=

# Domínio dos cookies de sessão. Vazio = domínio da própria resposta.
# Preencher só quando portal e API vivem em subdomínios distintos e o cookie
# precisa valer para os dois (ex.: .scpi.me).
AUTH_COOKIE_DOMAIN=


# ============================================================
# 4. AWS (Rekognition + S3)
# ============================================================

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=
# Coleção de rostos do Rekognition.
COLLECTION_ID=
# Bucket S3 onde ficam as fotos dos rostos.
BUCKET_NAME=


# ============================================================
# 5. NOTIFICAÇÕES POR E-MAIL (Resend)
# ============================================================

# Crie em resend.com → API Keys → Create API Key
RESEND_API_KEY=
# Use "onboarding@resend.dev" para testes, ou "Nome <email@dominio.com>" em produção
RESEND_FROM_EMAIL=SCPI <noreply@seudominio.com>

# O push (Expo/FCM) NÃO usa variável de ambiente: as credenciais ficam na conta
# Expo/EAS e o token de cada aparelho é registrado pelo app.


# ============================================================
# 6. BOOTSTRAP DO ADMIN
# ============================================================

# Consumidas por scripts/criar_admin.py na primeira carga do sistema.
ADMIN_NOME=
ADMIN_EMAIL=
ADMIN_SENHA=


# ============================================================
# 7. CLIENTES (portal web e app mobile)
# ============================================================

# A URL da API consumida pelo portal NÃO vem de variável de ambiente aqui:
# é definida em portal/js/env.js (window.__SCPI_API_URL__), editado à mão
# por deploy. Ver a seção do Portal no README.

# IP da máquina que roda o backend, acessível pelo celular na mesma rede.
# Propagada para o app por `npm run sync-env`.
EXPO_PUBLIC_API_URL=http://XXX:8000


# ============================================================
# 8. SUBSISTEMA CÂMERA — conexão e reconhecimento
#    (só na máquina com câmera física)
# ============================================================

# URL da API que o script reconhecimento_tempo_real.py vai consumir.
# Em produção use https://xxx.xxx. Em dev local, http://localhost:8000.
SCPI_API_URL=

# Token de serviço da câmera, emitido por sala com:
#   cd BackEnd && python scripts/camera_token.py emitir --sala "Sala 101"
# Vale só para a sala em que foi emitido. Não commitar o valor real.
# Revogar com: python scripts/camera_token.py revogar --id <id>
CAMERA_SERVICE_TOKEN=

# Índice do dispositivo de câmera (0 = primeira câmera). Use 1+ quando houver webcam USB
# externa além da integrada.
CAMERA_INDEX=0

# Similaridade mínima (0-100) exigida do Rekognition na câmera fixa.
# Distância variável, iluminação irregular, múltiplos rostos: o valor menor
# reflete maior tolerância empírica, NÃO menor exigência de segurança.
# Revisar se a taxa de false positives crescer. (90)
FACE_MATCH_THRESHOLD_SALA=

# Caminho do modelo YuNet de detecção facial (default: BackEnd/scripts/models/face_detection_yunet_2023mar.onnx)
FACE_MODEL_PATH=


# ============================================================
# 9. SUBSISTEMA CÂMERA — liveness / anti-spoofing
#    (defaults entre parênteses)
#
# Ordem de decisão no burst:
#   veto de tela (9.4)  >  textura (9.3)  >  pose (9.2, só no fallback)
# Veto de tela é fail-OPEN (erro no detector não veta).
# Textura é fail-CLOSED (sem score confiável → PENDENTE, não registra).
# ============================================================

# ---- 9.1 Burst ----
# Frames capturados por burst quando um rosto é detectado (5)
BURST_FRAMES=5
# Matches do MESMO aluno exigidos no burst — consenso X-de-Y (3)
BURST_MIN_MATCHES=3
# Duração da janela de captura do burst, em segundos (2)
BURST_DURACAO_S=2

# ---- 9.2 Pose ----
# Magnitude mínima hypot(std_yaw,std_pitch) da pose (3.0). ADVISORY quando a
# textura está ligada (só logada); vira gate no fallback ENABLE_TEXTURE=0.
LIVENESS_POSE_STD_MIN=3.0

# ---- 9.3 Textura (modelo CNN local) — gate de vida primário ----
# Liga (1) / desliga (0) o gate de textura. Ligado é o default. Desligado cai
# no fallback de pose (paliativo). (1)
ENABLE_TEXTURE=1
# Caminho do modelo facenox best_model.onnx NÃO-quantizado (1.9 MB).
# Baixe de: raw.githubusercontent.com/facenox/face-antispoof-onnx/main/models/best/98.20/best_model.onnx
# NÃO use o quantizado (626 KB): usa DynamicQuantizeLinear, incompatível com cv2.dnn.
# Default: BackEnd/scripts/models/best_model.onnx
TEXTURE_MODEL_PATH=
# Limiar do liveness score de textura (0..1) para aceitar como rosto vivo.
# CALIBRAR POR CÂMERA com scripts/_validar_liveness.py — o modelo mede nitidez
# tanto quanto vida, então geometria e iluminação mudam a faixa útil. (0.08)
TEXTURE_LIVENESS_MIN=0.08
# Piso de tamanho de rosto (lado menor do bbox, em px) para a textura opinar.
# Abaixo disso o score é None e o burst cai em PENDENTE (fail-closed).
# Não usar o default cego: com rosto muito pequeno, foto em tela mede ~0.99
# ("vivo"). Câmera com rosto de 20-55px em quadro está fora da faixa do modelo
# e precisa de gate geométrico, que ainda não existe. (80)
TEXTURE_FACE_MIN_PX=80

# ---- 9.4 Veto por região emissiva (tela) ----
# Rosto real não emite luz; rosto exibido está dentro de uma tela acesa.
# Tem precedência sobre a textura. Liga (1) / desliga (0). (1)
ENABLE_TELA=1
# Percentil de luminância DA CENA que define "área emissiva". Medido em uma
# iluminação só — sol direto ou janela no quadro pedem nova medição. (96)
TELA_PERCENTIL=96
# Frames do burst que precisam acusar tela para o veto disparar. Subir este
# valor (ou o percentil) se passagem legítima estiver sendo vetada. (2)
TELA_MIN_FRAMES=2


# ============================================================
# 10. LGPD
# ============================================================

# Assina o manifesto de integridade do export de dados pessoais (Art. 18 §1).
# Obrigatória. Gere com:
#   python -c "import secrets; print(secrets.token_hex(32))"
SCPI_EXPORT_HMAC_KEY=

# URL pública da política de privacidade, servida pelo portal (portal/privacy.html).
# O app lê esta URL do backend antes de exibir o aceite; a VERSÃO da política fica
# em BackEnd/core/config.py, não aqui.
# Produção: https://admin.scpi.me/privacy.html?app=1
# O ?app=1 esconde o link "Voltar ao Portal" — o aluno não deve ser levado
# para a área administrativa. Sem o param a página abre igual, só com o link.
# Vazia = link "Ver Política de Privacidade" não abre nada no app.
SCPI_PRIVACY_URL=


# ============================================================
# 11. OBSERVABILIDADE
# ============================================================

# DSN do projeto no Sentry SaaS. Vazio/ausente desativa o envio; dev normalmente
# fica sem. A LoggingIntegration está desligada no código de propósito (vazava
# dado pessoal por breadcrumbs) — não religar sem revisar o before_send.
SENTRY_DSN=


# ============================================================
# 12. DESENVOLVIMENTO E TESTES
#     (nada aqui é lido pelo fluxo de produção)
# ============================================================

# Opt-in dos testes de integração que precisam de Postgres real.
# Sem "1", eles são pulados sem tentar conectar.
SCPI_RUN_DB_TESTS=

# Ferramenta de medição do liveness (scripts/_validar_liveness.py):
# diretório onde as amostras são gravadas e rótulo da condição medida.
LIVENESS_SAMPLES_DIR=
LIVENESS_COND=
