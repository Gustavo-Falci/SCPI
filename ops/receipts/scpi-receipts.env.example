# Config do job de receipts — copiar para /etc/scpi-receipts.env
#   sudo cp scpi-receipts.env.example /etc/scpi-receipts.env
#   sudo chown root:root /etc/scpi-receipts.env && sudo chmod 600 /etc/scpi-receipts.env
#
# HC_URL é SEGREDO: quem tem a URL consegue mascarar falha do job, mandando
# ping de sucesso enquanto os receipts deixam de ser consultados. Mesma regra
# do HEALTHCHECK_URL em ops/backup.
#
# systemd lê este arquivo como root, antes de baixar para User=ubuntu — por
# isso 600 root:root funciona mesmo o serviço não rodando como root.

# --- Alerta (obrigatória) ---
# URL de ping do check "scpi-receipts" no healthchecks.io
HC_URL=
