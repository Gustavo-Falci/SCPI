# Config do backup de segredos SCPI — copiar para /etc/scpi-secrets.env
#   sudo cp scpi-secrets.env.example /etc/scpi-secrets.env
#   sudo chown root:root /etc/scpi-secrets.env && sudo chmod 600 /etc/scpi-secrets.env
# HEALTHCHECK_URL é SEGREDO: quem tem a URL consegue mascarar falha de backup.
# AGE_RECIPIENT é a chave PÚBLICA. A privada NUNCA entra nesta VM.

# --- age (obrigatória) ---
# Saída de `age-keygen -y chave.txt`, gerada na máquina do Gustavo
AGE_RECIPIENT=

# --- OCI (obrigatórias) ---
# Namespace do tenancy: `oci os ns get` ou console OCI
OCI_NAMESPACE=
OCI_BUCKET=scpi-backups

# --- Alerta (obrigatória) ---
# URL de ping do check "scpi-secrets" no healthchecks.io
HEALTHCHECK_URL=

# --- Opcionais (defaults do script) ---
#BACKUP_DIR=/var/backups/scpi-secrets
#OCI_BIN=/opt/oci-cli/bin/oci
#AGE_BIN=age
#CURL_BIN=curl
#MAX_BYTES=20971520
#OCI_PREFIX=secrets/

# Sobrescrever SECRET_PATHS/SYSTEMD_GLOB só em teste; produção usa o default do script.
#SECRET_PATHS=
#SYSTEMD_GLOB=
